<mujoco model="dexterous_hand">
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="hand">
      <joint type="hinge" axis="0 1 0" damping="0.02" armature="0.0005"/>
      <geom type="capsule" density="1000" friction="1.3 0.01 0.0005" condim="6" rgba="0.85 0.72 0.62 1"/>
      <position kp="10" kv="0.2" ctrlrange="0 1.4" forcerange="-2 2"/>
    </default>
  </default>

  <worldbody>
    <body name="hand_root" childclass="hand" gravcomp="1">
      <freejoint name="hand_free"/>
      <geom name="palm" type="box" pos="0.045 0 0" size="0.045 0.04 0.012" mass="0.4"/>
      <geom name="thenar" fromto="0.012 0.022 -0.016 0.05 0.02 -0.02" size="0.014" mass="0.02"/>
      <geom name="hypothenar" fromto="0.012 -0.026 -0.014 0.07 -0.03 -0.015" size="0.011" mass="0.02"/>

      <body name="index_proximal" pos="0.09 0.022 0" gravcomp="1">
        <joint name="index_mcp" range="0 1.57"/>
        <geom name="index_proximal" fromto="0 0 0 0.045 0 0" size="0.009"/>
        <body name="index_middle" pos="0.045 0 0" gravcomp="1">
          <joint name="index_pip" range="0 1.75"/>
          <geom name="index_middle" fromto="0 0 0 0.027 0 0" size="0.008"/>
          <body name="index_distal" pos="0.027 0 0" gravcomp="1">
            <joint name="index_dip" range="0 1.4"/>
            <geom name="index_distal" fromto="0 0 0 0.02 0 0" size="0.0075"/>
            <site name="index_tip" pos="0.02 0 -0.004" size="0.004" rgba="1 0 0 0.5"/>
          </body>
        </body>
      </body>

      <body name="middle_proximal" pos="0.092 0 0" gravcomp="1">
        <joint name="middle_mcp" range="0 1.57"/>
        <geom name="middle_proximal" fromto="0 0 0 0.048 0 0" size="0.009"/>
        <body name="middle_middle" pos="0.048 0 0" gravcomp="1">
          <joint name="middle_pip" range="0 1.75"/>
          <geom name="middle_middle" fromto="0 0 0 0.03 0 0" size="0.008"/>
          <body name="middle_distal" pos="0.03 0 0" gravcomp="1">
            <joint name="middle_dip" range="0 1.4"/>
            <geom name="middle_distal" fromto="0 0 0 0.021 0 0" size="0.0075"/>
            <site name="middle_tip" pos="0.021 0 -0.004" size="0.004" rgba="1 0 0 0.5"/>
          </body>
        </body>
      </body>

      <body name="thumb_proximal" pos="0.03 0.045 -0.012" quat="0.6217 -0.6151 -0.0510 0.4822" gravcomp="1">
        <joint name="thumb_mcp" range="0 1.2"/>
        <geom name="thumb_proximal" fromto="0 0 0 0.04 0 0" size="0.0095"/>
        <body name="thumb_distal" pos="0.04 0 0" gravcomp="1">
          <joint name="thumb_ip" range="0 1.3"/>
          <geom name="thumb_distal" fromto="0 0 0 0.03 0 0" size="0.0085"/>
          <site name="thumb_tip" pos="0.03 0 -0.004" size="0.004" rgba="1 0 0 0.5"/>
        </body>
      </body>

      <body name="ring_proximal" pos="0.088 -0.022 0" gravcomp="1">
        <joint name="ring_mcp" range="0 1.57"/>
        <geom name="ring_proximal" fromto="0 0 0 0.043 0 0" size="0.0085"/>
        <body name="ring_middle" pos="0.043 0 0" gravcomp="1">
          <joint name="ring_pip" range="0 1.75"/>
          <geom name="ring_middle" fromto="0 0 0 0.027 0 0" size="0.0078"/>
          <body name="ring_distal" pos="0.027 0 0" gravcomp="1">
            <joint name="ring_dip" range="0 1.4"/>
            <geom name="ring_distal" fromto="0 0 0 0.02 0 0" size="0.0072"/>
          </body>
        </body>
      </body>

      <body name="pinky_proximal" pos="0.08 -0.041 0" gravcomp="1">
        <joint name="pinky_mcp" range="0 1.57"/>
        <geom name="pinky_proximal" fromto="0 0 0 0.034 0 0" size="0.0075"/>
        <body name="pinky_middle" pos="0.034 0 0" gravcomp="1">
          <joint name="pinky_pip" range="0 1.75"/>
          <geom name="pinky_middle" fromto="0 0 0 0.02 0 0" size="0.0068"/>
          <body name="pinky_distal" pos="0.02 0 0" gravcomp="1">
            <joint name="pinky_dip" range="0 1.4"/>
            <geom name="pinky_distal" fromto="0 0 0 0.018 0 0" size="0.0063"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="thumb_proximal" body2="index_proximal"/>
    <exclude body1="thumb_proximal" body2="index_middle"/>
    <exclude body1="thumb_proximal" body2="index_distal"/>
    <exclude body1="thumb_proximal" body2="middle_proximal"/>
    <exclude body1="thumb_proximal" body2="middle_middle"/>
    <exclude body1="thumb_proximal" body2="middle_distal"/>
    <exclude body1="thumb_proximal" body2="ring_proximal"/>
    <exclude body1="thumb_proximal" body2="ring_middle"/>
    <exclude body1="thumb_proximal" body2="ring_distal"/>
    <exclude body1="thumb_proximal" body2="pinky_proximal"/>
    <exclude body1="thumb_proximal" body2="pinky_middle"/>
    <exclude body1="thumb_proximal" body2="pinky_distal"/>
    <exclude body1="thumb_distal" body2="index_proximal"/>
    <exclude body1="thumb_distal" body2="index_middle"/>
    <exclude body1="thumb_distal" body2="index_distal"/>
    <exclude body1="thumb_distal" body2="middle_proximal"/>
    <exclude body1="thumb_distal" body2="middle_middle"/>
    <exclude body1="thumb_distal" body2="middle_distal"/>
    <exclude body1="thumb_distal" body2="ring_proximal"/>
    <exclude body1="thumb_distal" body2="ring_middle"/>
    <exclude body1="thumb_distal" body2="ring_distal"/>
    <exclude body1="thumb_distal" body2="pinky_proximal"/>
    <exclude body1="thumb_distal" body2="pinky_middle"/>
    <exclude body1="thumb_distal" body2="pinky_distal"/>
    <exclude body1="hand_root" body2="index_middle"/>
    <exclude body1="hand_root" body2="index_distal"/>
    <exclude body1="hand_root" body2="middle_middle"/>
    <exclude body1="hand_root" body2="middle_distal"/>
    <exclude body1="hand_root" body2="ring_middle"/>
    <exclude body1="hand_root" body2="ring_distal"/>
    <exclude body1="hand_root" body2="pinky_middle"/>
    <exclude body1="hand_root" body2="pinky_distal"/>
    <exclude body1="hand_root" body2="thumb_distal"/>
    <exclude body1="hand_root" body2="index_proximal"/>
    <exclude body1="hand_root" body2="middle_proximal"/>
    <exclude body1="hand_root" body2="thumb_proximal"/>
    <exclude body1="hand_root" body2="ring_proximal"/>
    <exclude body1="hand_root" body2="pinky_proximal"/>
    <exclude body1="index_proximal" body2="middle_proximal"/>
    <exclude body1="index_middle" body2="middle_middle"/>
    <exclude body1="index_distal" body2="middle_distal"/>
    <exclude body1="middle_proximal" body2="ring_proximal"/>
    <exclude body1="middle_middle" body2="ring_middle"/>
    <exclude body1="middle_distal" body2="ring_distal"/>
    <exclude body1="ring_proximal" body2="pinky_proximal"/>
    <exclude body1="ring_middle" body2="pinky_middle"/>
    <exclude body1="ring_distal" body2="pinky_distal"/>
  </contact>

  <equality>
    <joint joint1="index_pip" joint2="index_mcp" polycoef="0 1.1 0 0 0"/>
    <joint joint1="index_dip" joint2="index_pip" polycoef="0 0.7 0 0 0"/>
    <joint joint1="middle_pip" joint2="middle_mcp" polycoef="0 1.1 0 0 0"/>
    <joint joint1="middle_dip" joint2="middle_pip" polycoef="0 0.7 0 0 0"/>
    <joint joint1="ring_mcp" joint2="middle_mcp" polycoef="0 1 0 0 0"/>
    <joint joint1="ring_pip" joint2="ring_mcp" polycoef="0 1.1 0 0 0"/>
    <joint joint1="ring_dip" joint2="ring_pip" polycoef="0 0.7 0 0 0"/>
    <joint joint1="pinky_mcp" joint2="middle_mcp" polycoef="0 1 0 0 0"/>
    <joint joint1="pinky_pip" joint2="pinky_mcp" polycoef="0 1.1 0 0 0"/>
    <joint joint1="pinky_dip" joint2="pinky_pip" polycoef="0 0.7 0 0 0"/>
    <joint joint1="thumb_ip" joint2="thumb_mcp" polycoef="0 1.0 0 0 0"/>
  </equality>

  <actuator>
    <position name="thumb" class="hand" joint="thumb_mcp" ctrlrange="0 1.2"/>
    <position name="index" class="hand" joint="index_mcp"/>
    <position name="middle" class="hand" joint="middle_mcp"/>
  </actuator>
</mujoco>
